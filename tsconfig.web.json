{
  // Type-checks the web-only entry points, which need DOM and Vite globals that
  // the native app's tsconfig deliberately excludes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom", "vite/client", "node"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "index.web.tsx", "web"],
  "exclude": ["node_modules", "dist-web"]
}
